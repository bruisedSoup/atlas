---
// src/pages/index.astro — Atlas landing page
const nextAppUrl = import.meta.env.NEXT_APP_URL ?? "http://localhost:3000";
const authError = Astro.url.searchParams.get("auth_error");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Atlas — Your Academic Command Center</title>
    <meta
      name="description"
      content="Atlas brings your to-dos, courses, schedule, and files into one clean dashboard. Sign in with your Google account to get started."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Inter', sans-serif;
        background: #fafaf9;
        color: #1a1a1a;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .wordmark {
        font-family: 'EB Garamond', serif;
        font-size: 3.5rem;
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 1;
        margin-bottom: 0.5rem;
      }

      .star {
        display: inline-block;
        font-size: 1.2rem;
        margin-right: 0.3rem;
        vertical-align: middle;
        position: relative;
        top: -0.15em;
      }

      .tagline {
        font-size: 1rem;
        color: #666;
        margin-bottom: 3rem;
        font-weight: 400;
      }

      .sign-in-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.75rem 1.5rem;
        background: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-family: 'Inter', sans-serif;
        font-size: 0.9375rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.15s ease, transform 0.1s ease;
      }

      .sign-in-btn:hover { background: #333; }
      .sign-in-btn:active { transform: scale(0.98); }

      .google-icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
      }

      .error-banner {
        margin-bottom: 1.5rem;
        padding: 0.75rem 1rem;
        background: #fee2e2;
        border: 1px solid #fca5a5;
        border-radius: 6px;
        color: #991b1b;
        font-size: 0.875rem;
      }

      footer {
        position: fixed;
        bottom: 1.5rem;
        font-size: 0.8125rem;
        color: #aaa;
      }
    </style>
  </head>
  <body>
    <main>
      <h1 class="wordmark"><span class="star">✦</span>Atlas</h1>
      <p class="tagline">Your academic command center.</p>

      {authError && <div class="error-banner">Sign-in error: {authError}</div>}

      <a id="signin-btn" href={`${nextAppUrl}/auth/login`} class="sign-in-btn">
        <!-- Google "G" SVG -->
        <svg class="google-icon" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615Z" fill="#4285F4"/>
          <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18Z" fill="#34A853"/>
          <path d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332Z" fill="#FBBC05"/>
          <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 6.29C4.672 4.163 6.656 3.58 9 3.58Z" fill="#EA4335"/>
        </svg>
        Sign in with Google
      </a>
    </main>
    <footer>Atlas &copy; {new Date().getFullYear()}</footer>
  </body>
</html>
