# Atlas API — environment variables
# Copy this to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=your-long-random-secret-key-here
DJANGO_DEBUG=True

# Supabase Postgres connection string
# Find it in: Supabase dashboard → project → Settings → Database → Connection string (URI)
DATABASE_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase JWT secret — used to verify tokens server-side
# Find it in: Supabase dashboard → project → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# CORS: comma-separated list of allowed frontend origins
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000
