---
// src/pages/index.astro — Plain Landing Page with link to Login
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Atlas — Your Academic Command Center</title>
    <meta name="description" content="Atlas brings your tasks, schedule, and courses together." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Inter', sans-serif;
        background: #ffffff;
        color: #111827;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .logo-img {
        width: 84px;
        height: auto;
        margin-bottom: 1rem;
        display: block;
      }

      .wordmark {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 2.75rem;
        font-weight: 500;
        letter-spacing: -0.01em;
        line-height: 1;
        margin-bottom: 0.75rem;
      }

      .tagline {
        font-size: 0.95rem;
        color: #6b7280;
        margin-bottom: 2.5rem;
        font-weight: 400;
      }

      .login-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 2rem;
        background: #000000;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.15s ease;
      }

      .login-btn:hover {
        background: #262626;
      }

      footer {
        position: fixed;
        bottom: 1.5rem;
        font-size: 0.8125rem;
        color: #9ca3af;
      }
    </style>
  </head>
  <body>
    <main style="display: flex; flex-direction: column; align-items: center; text-align: center;">
      <img src="/atlas_logo.png" alt="Atlas Logo" class="logo-img" />
      <h1 class="wordmark">Atlas</h1>
      <p class="tagline">A centralized dashboard for all your tasks.</p>
      <a href="/signin" class="login-btn">Log in</a>
    </main>
    <footer>Atlas &copy; {new Date().getFullYear()}</footer>
  </body>
</html>
